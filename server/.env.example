# Copy this file to .env and fill in your keys
# Never commit .env to git

# SearchAPI — https://www.searchapi.io (free tier: 100 requests/month)
SEARCH_API_KEY=your_searchapi_key_here

# Mapbox — https://account.mapbox.com (generous free tier: 50k loads/mo)
MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6InlvdXJhY2Nlc3N0b2tlbiJ9.example

# Google Places — https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Postgres — local MVP assumes Postgres.app and `createdb hirenear`
DATABASE_URL=postgres://localhost:5432/hirenear

# Claude — optional; without this, scout matching falls back to simple heuristics
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Notifications
BASE_URL=https://hirenear.app
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
NOTIFY_FROM_EMAIL=notify@hirenear.app
ADMIN_TOKEN=your_secret_admin_token

# Optional local development override. Production should stay near 3/day for SearchAPI free-tier safety.
MAX_SEARCHES_PER_DAY=3
MAX_PLACES_TO_SHOW=20
MAX_COMPANIES_TO_CHECK=20
SCOUT_INSPECTION_CONCURRENCY=2
SCOUT_INSPECTION_TTL_HOURS=48

PORT=3001
